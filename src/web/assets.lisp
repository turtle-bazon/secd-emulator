;;;; assets.lisp — everything the binary needs, embedded as base64.
;;;; Regenerated by Makefile on every build (touch + recompile).

(in-package #:secd-emulator.web)

(defun b64->string (b64)
  (babel:octets-to-string (cl-base64:base64-string-to-usb8-array b64)))

(defparameter *asset-index-html*
  (b64->string
   ""))

(defparameter *asset-js-main*
  (b64->string
   "Y29uc29sZS5lcnJvcignZnJvbnRlbmQganMgbm90IGJ1aWx0Jyk7"))

;;; alist: (name . raw-byte-vector) for precompiled examples
(defparameter *embedded-bytecodes*
  (list
   (cons "blink-stamp-s3a.secd"
         (cl-base64:base64-string-to-usb8-array
          ""))))
