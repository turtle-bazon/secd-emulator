;;;; server.lisp - SECD emulator server (Clack + Wookie + websocket-driver)
;;;;
;;;; Minimal first cut: take the proven echo.lisp structure, swap the
;;;; echo for VM-driven JSON state messages. JSON encode/decode goes
;;;; through com.inuoe.jzon (same library the web UI uses).

(in-package :secd-emulator.web)

(defvar *machine* nil)
(defvar *heap* nil)
(defvar *bps* '())
(defvar *console-out* '())
(defvar *console-conn* nil)
(defvar *running* nil)
(defvar *last-tick* 0)

;; Forward declarations so the dispatch function compiles even
;; though it references functions defined later in the file.
(declaim (ftype (function () t) do-step send-state send-hello
                          send-console send-devices run-tick pump-run-loop))
(declaim (ftype (function (t) t) send-halted))
(declaim (ftype (function (string) t) parse-stringify))

(defun make-fresh-machine ()
  (let* ((h (secd-emulator.vm:make-heap :objects 512 :arena-bytes 65536))
         (m (secd-emulator.vm:make-machine h)))
    (secd-emulator.vm:install-default-prims m)
    (let ((by (lambda (nm) (lambda (hi a) (funcall (gethash nm secd-emulator.vm:*prim-impls*) hi a)))))
      (setf (gethash secd-emulator.vm:+op-add+ secd-emulator.vm:*core-op-fns*) (funcall by "+"))
      (setf (gethash secd-emulator.vm:+op-sub+ secd-emulator.vm:*core-op-fns*) (funcall by "-"))
      (setf (gethash secd-emulator.vm:+op-mul+ secd-emulator.vm:*core-op-fns*) (funcall by "*"))
      (setf (gethash secd-emulator.vm:+op-div+ secd-emulator.vm:*core-op-fns*) (funcall by "/"))
      (setf (gethash secd-emulator.vm:+op-mod+ secd-emulator.vm:*core-op-fns*) (funcall by "%"))
      (setf (gethash secd-emulator.vm:+op-eq+  secd-emulator.vm:*core-op-fns*) (funcall by "="))
      (setf (gethash secd-emulator.vm:+op-lt+  secd-emulator.vm:*core-op-fns*) (funcall by "<"))
      (setf (gethash secd-emulator.vm:+op-gt+  secd-emulator.vm:*core-op-fns*) (funcall by ">")))
    (secd-emulator.vm:heap-alloc h secd-emulator.vm:+tag-pair+)
    (setf (secd-emulator.vm:machine-console-out-hook m)
          (lambda (line) (push line *console-out*)))
    (setf *heap* h *machine* m *bps* '() *console-out* '())
    m))

(defun handle->json (v heap)
  (cond ((null v) '(("kind" . "undef")))
        ((eql v secd-emulator.vm:+nil+)  '(("kind" . "nil")))
        ((eql v secd-emulator.vm:+true+) '(("kind" . "t")))
        ((eql v secd-emulator.vm:+false+) '(("kind" . "nil")))
        (t
         (let* ((tag (secd-emulator.vm:handle-tag v))
                (idx (secd-emulator.vm:handle-index v))
                (cell-tag (aref (secd-emulator.vm:heap-types heap) idx)))
           (cond
             ((= tag secd-emulator.vm:+tag-fixnum+)
              `(("kind" . "fixnum") ("i" . ,idx) ("num" . ,(secd-emulator.vm:fixnum-value v))))
             ((= tag secd-emulator.vm:+tag-pair+)
              `(("kind" . "pair") ("i" . ,idx)
                ("car" . ,(handle->json (secd-emulator.vm:heap-car heap idx) heap))
                ("cdr" . ,(handle->json (secd-emulator.vm:heap-cdr heap idx) heap))))
             ((= tag secd-emulator.vm:+tag-bytevec+)
              `(("kind" . "bytevec") ("i" . ,idx) ("len" . ,(secd-emulator.vm:bv-len heap idx))))
             (t `(("kind" . "obj") ("i" . ,idx))))))))

(defun heap->json (heap)
  (loop for i from 0 below (secd-emulator.vm:heap-size heap)
        for tag = (aref (secd-emulator.vm:heap-types heap) i)
        when (/= tag 255)
        collect `(("addr" . ,i)
                  ("tag" . ,(cond ((= tag secd-emulator.vm:+tag-fixnum+) "fixnum")
                                    ((= tag secd-emulator.vm:+tag-pair+)   "pair")
                                    ((= tag secd-emulator.vm:+tag-bytevec+) "bytevec")
                                    (t "obj")))
                  ("car" . ,(secd-emulator.vm:heap-car heap i))
                  ("cdr" . ,(secd-emulator.vm:heap-cdr heap i)))))

(defun state-json-string ()
  (when (null *machine*) (return-from state-json-string "{\"ip\":0,\"sp\":0,\"steps\":0,\"error\":0,\"halted\":true,\"code\":[],\"stack\":[],\"e\":{\"kind\":\"nil\"},\"g\":{\"kind\":\"nil\"},\"d\":{\"kind\":\"nil\"},\"heap\":[],\"breakpoints\":[]}"))
  (let ((m *machine*) (heap *heap*) (o (make-string-output-stream)))
    (format o "{\"ip\":~D,\"sp\":~D,\"steps\":~D,\"error\":~D,\"halted\":~A,\"code\":["
            (secd-emulator.vm:machine-ip m) (secd-emulator.vm:machine-sp m) (secd-emulator.vm:machine-steps m)
            (secd-emulator.vm:machine-error-code m) (if (secd-emulator.vm:halted-p m) "true" "false"))
    (loop for bv across (secd-emulator.vm:machine-code m)
          for firstp = t then nil do
            (unless firstp (write-char #\, o))
            (format o "~D" bv))
    (format o "],\"stack\":[")
    (loop for i from 0 below (secd-emulator.vm:machine-sp m)
          for v = (aref (secd-emulator.vm:machine-stack m) i)
          for firstp = t then nil do
            (unless firstp (write-char #\, o))
            (format o "~A" (handle->json v heap)))
    (format o "],\"e\":~A,\"g\":~A,\"d\":{\"kind\":\"nil\"},\"heap\":["
            (handle->json (secd-emulator.vm:machine-e m) heap)
            (handle->json (secd-emulator.vm:machine-g m) heap))
    (loop for i from 0 below (secd-emulator.vm:heap-size heap)
          for tag = (aref (secd-emulator.vm:heap-types heap) i)
          when (/= tag 255)
          do (format o "~A{\"addr\":~D,\"tag\":\"~A\",\"car\":~D,\"cdr\":~D}"
                     (if (zerop (length (get-output-stream-string o))) "" ",") i
                     (cond ((= tag secd-emulator.vm:+tag-fixnum+) "fixnum")
                           ((= tag secd-emulator.vm:+tag-pair+)   "pair")
                           ((= tag secd-emulator.vm:+tag-bytevec+) "bytevec")
                           (t "obj"))
                     (secd-emulator.vm:heap-car heap i) (secd-emulator.vm:heap-cdr heap i)))
    (format o "],\"breakpoints\":[")
    (loop for b in *bps* for firstp = t then nil do
      (unless firstp (write-char #\, o))
      (format o "~D" b))
    (format o "]}")
    (get-output-stream-string o)))

(defun ws-send (text)
  (when *console-conn*
    (handler-case (websocket-driver:send *console-conn* text)
      (error (kk) (format *error-output* "[ws-send-err] ~A~%" kk)))))

(defun send-state ()
  (ws-send (concatenate 'string "{\"type\":\"state\"," (state-json-string) "}")))

(defun send-halted (err)
  (ws-send (stringify
            (alexandria:plist-alist
             `(("type" . "halted") ("error" . ,err))))))

(defun send-hello ()
  (ws-send "{\"type\":\"hello\"}"))

(defun send-console (text)
  (ws-send (stringify
            (alexandria:plist-alist
             `(("type" . "console") ("text" . ,text))))))

(defun send-devices ()
  (let* ((list
           (loop for (name . plist) in
                     '(("stamp-s3a"      . (:board "M5Stack Stamp-S3A" :chip "esp32s3"))
                       ("black-pill-f401" . (:board "Black Pill F401" :chip "stm32f401"))
                       ("blue-pill"      . (:board "Blue Pill STM32F103" :chip "stm32f103")))
                 collect (alexandria:plist-alist
                           `(("name" . ,name)
                             ("board" . ,(getf plist :board))
                             ("chip" . ,(getf plist :chip)))))))
    (ws-send (concatenate 'string
                         "{\"type\":\"devices\",\"list\":"
                         (stringify list)
                         "}"))))

(defun do-step ()
  (when (and *machine*
             (not (secd-emulator.vm:halted-p *machine*))
             (zerop (secd-emulator.vm:machine-error-code *machine*)))
    (secd-emulator.vm:step-once *machine*)))

(defun run-tick ()
  (cond ((null *machine*) (setf *running* nil))
        ((secd-emulator.vm:halted-p *machine*) (setf *running* nil))
        (t (do-step))))

(defun pump-run-loop ()
  (when *running*
    (let ((now (get-internal-real-time)))
      (when (> (- now *last-tick*) 50000)
        (setf *last-tick* now)
        (run-tick)))))

(defun handle-select-msg (m)
  (let ((name (or (gethash "name" m) "")))
    (ws-send (stringify (alexandria:plist-alist `(("type" . "selected") ("name" . ,name)))))))

(defun handle-load-msg (m)
  (handler-case
      (progn
        (make-fresh-machine)
        (let* ((b64 (or (gethash "bytecode-b64" m) ""))
               (bytes (ignore-errors (base64-string-to-usb8-array b64)))
               (result (if (and bytes (plusp (length bytes)))
                           (secd-emulator.vm:load-bytecode *machine* bytes)
                           :empty)))
          (format *error-output* "[load] ~A~%" result)
          (send-state)))
    (error (kk) (format *error-output* "[load-err] ~A~%" kk))))

(defun handle-step-msg ()
  (do-step)
  (send-state)
  (when (and *machine* (secd-emulator.vm:halted-p *machine*))
    (send-halted (secd-emulator.vm:machine-error-code *machine*))))

(defun handle-breakpoint-msg (m)
  (let* ((addr (gethash "addr" m)) (on (gethash "on" m)))
    (when (and addr on)
      (cond ((eq on t) (pushnew addr *bps* :test #'=))
            ((eq on :false) (setf *bps* (remove addr *bps* :test #'=)))))
    (send-state)))

(defun handle-console-in-msg (m)
  (let ((text (or (gethash "text" m) "")))
    (when *machine*
      (loop for ch across text do (secd-emulator.vm:machine-console-in-push *machine* (char-code ch))))))

(defun dispatch (msg-str)
  (let* ((m (parse msg-str)) (cmd (or (gethash "cmd" m) "")))
    (format *error-output* "[dispatch] cmd=~A m-type=~A~%" cmd (type-of m))
    (cond
      ((string= cmd "devices") (send-devices))
      ((string= cmd "select") (handle-select-msg m))
      ((string= cmd "load") (handle-load-msg m))
      ((string= cmd "step") (handle-step-msg))
      ((string= cmd "run") (when (and *machine* (not (secd-emulator.vm:halted-p *machine*))) (setf *running* t)))
      ((string= cmd "pause") (setf *running* nil) (send-state))
      ((string= cmd "reset") (setf *running* nil) (when *machine* (secd-emulator.vm:reset-machine *machine*)) (send-state))
      ((string= cmd "breakpoint") (handle-breakpoint-msg m))
      ((string= cmd "console-in") (handle-console-in-msg m))
      (t (format *error-output* "[dispatch] unknown cmd: ~A~%" cmd)))))

(defun handle-ws-upgrade (env)
  (let ((ws (websocket-driver:make-server env)))
    (setf *console-conn* ws)
    (websocket-driver:on :open ws (lambda () (send-hello)))
    (websocket-driver:on :message ws
      (lambda (msg)
        (handler-case
            (progn
              (format *error-output* "[ws-msg] cmd: ~A~%" (gethash "cmd" (parse msg)))
              (dispatch msg)
              (pump-run-loop))
          (error (kk) (format *error-output* "[ws-msg-err] ~A: ~A~%" kk msg)))))
    (websocket-driver:on :close ws
      (lambda (&key code reason)
        (declare (ignore code reason))
        (when (eq ws *console-conn*)
          (setf *console-conn* nil *running* nil))))
    (lambda (responder)
      (declare (ignore responder))
      (websocket-driver:start-connection ws))))

(defun www-root ()
  (let ((sys (asdf:find-system :secd-emulator)))
    (merge-pathnames "www/"
                     (if sys (asdf:component-pathname sys) (make-pathname)))))

(defun serve-file (path)
  (handler-case
      (let* ((bytes (alexandria:read-file-into-byte-vector path))
             (text  (babel:octets-to-string bytes))
             (len   (length bytes)))
        (list 200
              (list :content-type "text/html; charset=utf-8"
                    :content-length len)
              (list text)))
      (error () '(404 (:content-type "text/plain") ("not found")))))

(defun clack-app (env)
  (let ((uri (or (getf env :path-info) "/")))
    (cond ((string= uri "/secd")
           (handle-ws-upgrade env))
          ((or (string= uri "/") (string= uri ""))
           (serve-file (merge-pathnames "index.html" (www-root))))
          (t
           (let ((full (merge-pathnames (subseq uri 1) (www-root))))
             (if (and (probe-file full) (not (uiop:directory-exists-p full)))
                 (serve-file full)
                 (serve-file (merge-pathnames "index.html" (www-root)))))))))

(defun start-server (&key (address "0.0.0.0") (port 8899))
  (unless *machine* (ignore-errors (make-fresh-machine)))
  (bt:make-thread
   (lambda () (loop (pump-run-loop) (sleep 0.05)))
   :name "secd-run-pump")
  (let ((backend (or (uiop:getenv "CLACK_BACKEND") "wookie")))
    (format t "starting SECD server on ~A:~D (backend=~A)~%" address port backend)
    (clack:clackup #'clack-app
                   :server (intern (string-upcase backend) :keyword)
                   :address address
                   :port port
                   :use-thread nil
                   :debug nil)))

(defun main (&rest args)
  (declare (ignore args))
  (start-server))))
